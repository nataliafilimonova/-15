 #include <stdio.h>
#include <math.h>
#include <locale.h>

#define M 5
#define PI 3.1415926535

int task2() {
    float b[100];
    float k;
    float res = 0;
    float start, end, h;
    float x;

    printf("=== ЗАДАНИЕ 2 ===\n");
    printf("Введите начало диапазона: ");
    scanf("%f", &start);
    printf("Введите конец диапазона: ");
    scanf("%f", &end);
    printf("Введите значение k: ");
    scanf("%f", &k);

    if (end == start) {
        printf("Ошибка: начало и конец диапазона совпадают.\n\n");
        return 1;
    }

    h = (end - start) / 99.0;

    for (int i = 0; i < 100; i++) {
        x = start + i * h;
        b[i] = (x * x) - (cos(PI * x) * cos(PI * x));

        if ((b[i] < -k || b[i] > -k / 2.0) && (b[i] > k)) {
            res += b[i];
        }
    }

    printf("Сумма по условию варианта: %.4f\n\n", res);
    return 0;
}

int task3() {
    float c[M];
    float mx, cur;
    int pos = 0;

    printf("=== ДОМАШНЕЕ ЗАДАНИЕ (Вариант 30) ===\n");
    printf("Введите %d элементов массива:\n", M);

    for (int i = 0; i < M; i++) {
        printf("c[%d] = ", i + 1);
        scanf("%f", &c[i]);
    }

    mx = (c[0] + c[1]) / 2.0;

    for (int i = 1; i < M - 1; i++) {
        cur = (c[i] + c[i + 1]) / 2.0;
        if (cur > mx) {
            mx = cur;
            pos = i;
        }
    }

    printf("Наибольшее среднее: %.2f\n", mx);
    printf("Элементы: %d и %d (значения %.1f и %.1f)\n",
           pos + 1, pos + 2, c[pos], c[pos + 1]);

    return 0;
}

int main() {
    setlocale(LC_ALL, "Russian");

    task2();
    task3();
    return 0;
}
